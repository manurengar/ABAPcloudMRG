@Metadata.layer: #CORE
@UI.headerInfo:
{
    typeName: 'Certificate management',
    typeNamePlural: 'List of certificates',
    typeImageUrl: 'sap-icon://attachment-e-pub',
    imageUrl: 'AttachmentTuev',
    title.label: 'Product:',
    title.value: 'Product',
    title.type: #STANDARD,
    description.label: 'Version',
    description.value: 'Version',
    description.type: #STANDARD
}

@UI.presentationVariant:
[{
    qualifier: 'productASC',
    maxItems: 5,
    text: 'Sorting by Product asc.',
    sortOrder: [{ by: 'Product', direction: #ASC }],
    visualizations: [{ type: #AS_LINEITEM }]
}]

@UI.selectionVariant:
[{
    qualifier: 'activeCertificates',
    text: 'Active Certificates',
    filter: 'Criticality EQ 3'
},
{
    qualifier: 'newCertificates',
    text: 'New Certificates',
    filter: 'Criticality EQ 2'
},
{
    qualifier: 'inactiveCertificates',
    text: 'Inactive Certificates',
    filter: 'Criticality EQ 1'
}]

@UI.selectionPresentationVariant:
[{
    id: 'activeSPV',
    qualifier: 'activeSPV',
    text: 'Product ASC and active Certificates',
    presentationVariantQualifier: 'productASC',
    selectionVariantQualifier: 'activeCertificates'
},
{
    id: 'inactiveSPV',
    qualifier: 'inactiveSPV',
    text: 'Product ASC and inactive Certificates',
    presentationVariantQualifier: 'productASC',
    selectionVariantQualifier: 'inactiveCertificates'
},
{
    id: 'newSPV',
    qualifier: 'newSPV',
    text: 'Product ASC and new Certificates',
    presentationVariantQualifier: 'productASC',
    selectionVariantQualifier: 'newCertificates'
}]
annotate entity zmrg_c_certificate with
{
  @UI.facet:
  [{
    purpose: #HEADER,
    type: #FIELDGROUP_REFERENCE,
    importance: #HIGH,
    position: 10,
    label: 'Certificate Details',
    targetQualifier: 'headerData'
  },
  {
    id: 'CertificateDetails',
    purpose: #STANDARD,
    type: #IDENTIFICATION_REFERENCE,
    label: 'Certificate Details',
    position: 20
  },
  {
    purpose: #STANDARD,
    type: #FIELDGROUP_REFERENCE,
    importance: #HIGH,
    position: 30,
    targetQualifier: 'CertificateDetails',
    label: 'Certificate Details'
  },
  {
    id: 'CertificateStateTable',
    purpose: #STANDARD,
    type: #LINEITEM_REFERENCE,
    position: 40,
    label: 'Certificate Status',
    targetElement: '_CertificateState' 
  }]

  @UI.hidden: true
  CertUUID;

  @UI.selectionField: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  @UI.lineItem: [{ position: 10 },
                 { type: #FOR_ACTION, dataAction: 'newVersion', label: 'Set new version' },
                 { type: #FOR_ACTION, dataAction: 'releaseVersion', label: 'Activate Certificate' },
                 { type: #FOR_ACTION, dataAction: 'archiveVersion', label: 'Set to inactive' }]
  Product;

  @UI.fieldGroup: [{ qualifier: 'headerData', position: 10 }]
  @UI.identification: [{ position: 10 }]
  @UI.lineItem: [{ position: 20, importance: #LOW }]
  ProductName;

  @UI.fieldGroup: [{ qualifier: 'headerData', position: 20 }]
  @UI.selectionField: [{ position: 20 }]
  @UI.lineItem: [{ position: 30 }]
  Version;

  @UI.fieldGroup: [{ qualifier: 'headerData', position: 30 }]
  @UI.lineItem: [{ position: 40, importance: #MEDIUM }]
  StatusText;

  @UI.selectionField: [{ position: 30 }]
  @UI.lineItem: [{ position: 50, importance: #LOW }]
  Criticality;

  @UI.lineItem: [{ position: 60, label: 'Created by', importance: #LOW }]
  CreatedBy;

  @UI.lineItem: [{ position: 70, label: 'Created at', importance: #LOW }]
  CreatedAt;

  @UI.lineItem: [{ position: 80, label: 'Last changed by', importance: #LOW }]
  LocalLastChangedBy;
  
  @UI.hidden: true
  LocalLastChangedAt;

  @UI.fieldGroup: [{ qualifier: 'CertificateDetails', position: 10 }]
  CertificateCe;
  @UI.fieldGroup: [{ qualifier: 'CertificateDetails', position: 20, label: 'CE Attachment' }]
  AttachmentCE;

  @UI.fieldGroup: [{ qualifier: 'CertificateDetails', position: 30 }]
  CertificateGs;
  @UI.fieldGroup: [{ qualifier: 'CertificateDetails', position: 40, label: 'GS Attachment' }]
  AttachmentGS;

  @UI.fieldGroup: [{ qualifier: 'CertificateDetails', position: 50 }]
  CertificateTuev;
  @UI.fieldGroup: [{ qualifier: 'CertificateDetails', position: 60 }]
  AttachmentTuev;
  
  @UI.fieldGroup: [{ qualifier: 'CertificateDetails', position: 70 }]
  virtualSampleText;
}