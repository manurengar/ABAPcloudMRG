@EndUserText.label: 'Redefinition'
@MappingRole: true

// Replace the value for value help activity and also keep the 03 value display

define role ZMRG_C_SALESORDER_REPLACEMENT {
    grant 
        select
            on
                ZMRG_C_SALESORDER_REPLACEMENT
                    where inheriting conditions from entity ZMRG_I_SALESORDER_REPLACEMENT
                        replacing { pfcg_filter field ACTVT value '03' with 'F4' }
                     or 
                     inheriting conditions from entity ZMRG_I_SALESORDER_REPLACEMENT;
                        
                        
}