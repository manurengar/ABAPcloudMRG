@EndUserText.label: 'Access control with qualifier'
@MappingRole: true

// This one will filter those fields not contained on the role authorization group
// However as the association is one to many, then if on those many there are at least 1 authorization group
// that is allowed, all other entries of the association that matches the key will also be visible ( even those with )
// authorizations group not allowed

define role ZMRG_I_SALESORDER_QUALIFI {
    grant
        select
            on
                ZMRG_I_SALESORDER_QUALIFI
                    where
                        ( _Item._Product.AuthorizationGroup ) ?= aspect pfcg_auth( ZMRG_MMAT, ZMRG_BEGRU, ACTVT = '03' );
}