@EndUserText.label: 'Access control with qualifier'
@MappingRole: true

// To solve the last topic, we can filter associations that have at least one authorization group not granted by adding ALL

define role ZMRG_I_SALESORDER_QUALIFI2 {
    grant
        select
            on
                ZMRG_I_SALESORDER_QUALIFI
                    where all
                        ( _Item._Product.AuthorizationGroup ) ?= aspect pfcg_auth( ZMRG_MMAT, ZMRG_BEGRU, ACTVT = '03' );
}