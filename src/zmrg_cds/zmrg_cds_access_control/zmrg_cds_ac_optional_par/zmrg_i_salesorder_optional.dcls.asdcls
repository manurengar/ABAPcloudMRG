@EndUserText.label: 'Optional params AC'
@MappingRole: true

// The default value applies if the element on CDS is missing for an inheriting CDS role
define role ZMRG_I_SALESORDER_OPTIONAL {
    grant 
        select
            on
                ZMRG_I_SALESORDER_OPTIONAL
                with optional elements ( SalesOrganization default true,
                                         DistributionChannel default true,
                                         OrganizationDivision default true )
                    where
                         ( SalesOrganization, DistributionChannel, OrganizationDivision )
                           = aspect pfcg_auth ( ZMRG_VKO, ZMRG_VKORG, ZMRG_VTWEG, ZMRG_SPART, ACTVT = '03' );
                        
}